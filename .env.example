# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database & Cache ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://clouddeploy:clouddeploy@localhost:5432/clouddeploy?schema=public"
REDIS_URL="redis://localhost:6382"

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-plus-character-secret"
JWT_REFRESH_EXPIRY="30d"
COOKIE_SECRET="change-me-to-a-random-32-plus-character-secret"
ENCRYPTION_KEY="change-me-to-a-random-32-plus-character-secret"

# ── GitHub OAuth / App ───────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe Billing ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Object Storage (MinIO locally / S3-compatible in production) ───────────
S3_ENDPOINT="http://localhost:9002"
S3_ACCESS_KEY="clouddeploy"
S3_SECRET_KEY="clouddeploy-dev-secret"
S3_REGION="us-east-1"
S3_BUCKET="clouddeploy-platform"
S3_BACKUPS_BUCKET="clouddeploy-backups"

# ── Email (defaults target the local Mailpit container — infra/docker/docker-compose.yml — web UI at :8025) ─
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CloudDeploy <notifications@clouddeploy.local>"

# ── Local Postgres container (used to shell out to pg_dump/psql for backups) ─
POSTGRES_CONTAINER_NAME="clouddeploy-postgres-1"

# ── Deployment infrastructure ────────────────────────────────────────────
REGISTRY_URL="localhost:5050"
TRAEFIK_API="http://localhost:8090"

# ── Public URLs ──────────────────────────────────────────────────────────
WEB_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
PLATFORM_DOMAIN="clouddeploy.local"

# ── Frontend (apps/web) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Runtime agent (apps/runtime-agent — run on each runtime node) ────────
# Register the node first: POST /api/v1/admin/infrastructure/servers as a
# platform admin, then copy the one-time `agentToken` from the response.
# AGENT_TOKEN=
# API_URL="http://localhost:4000"
# HEARTBEAT_INTERVAL_MS=15000
# CONTAINER_LABEL_KEY="com.clouddeploy.container-id"
