{
  "name": "@clouddeploy/runtime-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone agent that runs on a runtime node: reports real host/container telemetry to the control plane and executes queued server commands.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@clouddeploy/docker": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20" }
}
