{
  "name": "clouddeploy",
  "version": "0.1.0",
  "private": true,
  "description": "CloudDeploy — Deploy Your Entire Application. Frontend + Backend + Database. One Deploy.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "npm run generate --workspace=@clouddeploy/database",
    "db:migrate": "npm run migrate:dev --workspace=@clouddeploy/database",
    "db:seed": "npm run seed --workspace=@clouddeploy/database",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "prepare": "node -e \"try{require('husky')}catch(e){}\""
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.11.0"
}
