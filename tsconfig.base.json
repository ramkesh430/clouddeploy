{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@clouddeploy/types": ["packages/types/src"],
      "@clouddeploy/types/*": ["packages/types/src/*"],
      "@clouddeploy/config": ["packages/config/src"],
      "@clouddeploy/config/*": ["packages/config/src/*"],
      "@clouddeploy/database": ["packages/database/src"],
      "@clouddeploy/database/*": ["packages/database/src/*"],
      "@clouddeploy/auth": ["packages/auth/src"],
      "@clouddeploy/auth/*": ["packages/auth/src/*"],
      "@clouddeploy/logger": ["packages/logger/src"],
      "@clouddeploy/logger/*": ["packages/logger/src/*"],
      "@clouddeploy/deployment-core": ["packages/deployment-core/src"],
      "@clouddeploy/deployment-core/*": ["packages/deployment-core/src/*"],
      "@clouddeploy/docker": ["packages/docker/src"],
      "@clouddeploy/docker/*": ["packages/docker/src/*"],
      "@clouddeploy/git": ["packages/git/src"],
      "@clouddeploy/git/*": ["packages/git/src/*"],
      "@clouddeploy/storage": ["packages/storage/src"],
      "@clouddeploy/storage/*": ["packages/storage/src/*"],
      "@clouddeploy/billing": ["packages/billing/src"],
      "@clouddeploy/billing/*": ["packages/billing/src/*"],
      "@clouddeploy/security": ["packages/security/src"],
      "@clouddeploy/security/*": ["packages/security/src/*"],
      "@clouddeploy/monitoring": ["packages/monitoring/src"],
      "@clouddeploy/monitoring/*": ["packages/monitoring/src/*"],
      "@clouddeploy/sdk": ["packages/sdk/src"],
      "@clouddeploy/sdk/*": ["packages/sdk/src/*"],
      "@clouddeploy/ui": ["packages/ui/src"],
      "@clouddeploy/ui/*": ["packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
